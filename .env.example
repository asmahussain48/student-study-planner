# Copy this file to `.env` and fill in the real values. DO NOT commit your real .env file to version control.

# Gemini / Google Generative AI Developer API key (preferred variable name)
# Obtain a developer API key from Google AI Studio (or the Gemini Developer docs) and place it here.
GEMINI_API_KEY=your_gemini_developer_api_key_here

# Backwards-compatible fallback variable name (optional)
# GOOGLE_API_KEY=your_google_api_key_here

# Other environment variables (examples)
# FLASK_APP=app.py
# FLASK_ENV=development
